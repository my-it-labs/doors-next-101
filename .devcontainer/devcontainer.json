{
  "name": "IBM DOORS Next 101",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [9443, 9080, 8025],
  "portsAttributes": {
    "9443": { "label": "DOORS Next (HTTPS)", "protocol": "https", "onAutoForward": "silent" },
    "9080": { "label": "DOORS Next (HTTP)", "onAutoForward": "silent" },
    "8025": { "label": "Mailpit", "onAutoForward": "silent" }
  },
  "postCreateCommand": "chmod +x infra/up.sh infra/down.sh"
}
