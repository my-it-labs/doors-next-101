# Reverse proxy experimental para servir DOORS Next por el dominio del proxy de
# Codespaces (*.app.github.dev), reescribiendo la URI pública fija localhost:9443.
#
# PROXY_DOMAIN se inyecta por entorno (ej: nombre-8443.app.github.dev) y el propio
# entrypoint de la imagen nginx hace envsubst de las plantillas en /etc/nginx/templates.

server {
    listen 8443;
    server_name _;

    # Cuerpo grande para reescritura sin truncar
    client_max_body_size 0;

    location / {
        proxy_pass https://doors:9443;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;

        # DOORS genera URLs desde su URI pública (localhost:9443), no desde Host.
        # Mantener Host=localhost:9443 para que el backend se reconozca.
        proxy_set_header Host localhost:9443;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${PROXY_DOMAIN};

        # Necesario para que sub_filter pueda reescribir (sin gzip)
        proxy_set_header Accept-Encoding "";

        # Reescritura de cabeceras Location (redirects 30x), forma literal y regex
        proxy_redirect https://localhost:9443 https://${PROXY_DOMAIN};
        proxy_redirect http://localhost:9443  https://${PROXY_DOMAIN};
        proxy_redirect ~*^https?://localhost:9443(?<rest>.*)$ https://${PROXY_DOMAIN}$rest;

        # Reescritura del cuerpo en todas las formas de codificación del literal
        sub_filter_once off;
        sub_filter_types *;
        sub_filter "https://localhost:9443"        "https://${PROXY_DOMAIN}";
        sub_filter "http://localhost:9443"         "https://${PROXY_DOMAIN}";
        sub_filter "https:\/\/localhost:9443"      "https:\/\/${PROXY_DOMAIN}";
        sub_filter "https%3A%2F%2Flocalhost%3A9443" "https%3A%2F%2F${PROXY_DOMAIN}";
        sub_filter "localhost:9443"                "${PROXY_DOMAIN}";

        proxy_read_timeout 300;
        proxy_send_timeout 300;
    }
}
